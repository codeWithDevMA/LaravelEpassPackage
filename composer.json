{
    "name": "ghazali/epass-package",
    "description": "Headless Laravel package for ePass authentication, passport verification, and Play Integrity attestation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "paragonie/pqcrypto_compat": "^0.3.2",
        "paragonie/sodium_compat": "^2.0",
        "phpseclib/phpseclib": "^3.0",
        "ghazali/laravel-hybrid-crypto": "^1.0",
        "spatie/laravel-package-tools": "^1.16",
        "ghazali/universal-probabilistic-engine": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ghazali\\EPassPackage\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ghazali\\EPassPackage\\EPassServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "classmap-authoritative": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
