* text=auto eol=lf

# Exclude development tools, tests, and sensitive configs from Composer dist archives
/tests                   export-ignore
/database/seeders        export-ignore
/.github                 export-ignore
/.idea                   export-ignore
/.vscode                 export-ignore
/phpunit.xml             export-ignore
/.phpunit.result.cache   export-ignore
/.editorconfig           export-ignore
/.env                    export-ignore
/.env.example            export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/bin                     export-ignore
/generate-field-keys.php export-ignore
